<?xml version="1.0" encoding="utf-8" ?>
<Patch>



<!-- Go juice stock -->



<!-- research -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/RecipeDef[defName="VBE_MakeGoJuiceStock"]/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>Ferny_GoJuiceStock</researchPrerequisite>
        </value>
    </Operation>

<!-- OLD: A gelatinized cube of Go-Juice, able to be digested rather than injected. While it can be used in any meal, it is often melted into soups or used as a thickening agent in cocktails. Provides a very diluted version of the drug without risk of addictions. -->

  <Operation Class="PatchOperationReplace">
      <success>Always</success>
      <xpath>Defs/ThingDef[defName="VBE_GoJuiceStock"]/description</xpath>
      <value>
		<description>A gelatinized cube of Go-Juice, able to be digested rather than injected. When applied to a gourmet meal, it provides a very diluted version of the drug without risk of addictions.</description>
      </value>
  </Operation>







