<?xml version="1.0" encoding="utf-8" ?>
<Patch>          

<!-- ORIGINAL
Make skewer sticks from a log.
 -->
<Operation Class="PatchOperationFindMod">
<mods>
    <li>Medieval Overhaul</li>
</mods>
<match Class="PatchOperationSequence">
    <operations>
    <li Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/RecipeDef[defName="chrisb_Craft_moas_sticks"]/label</xpath>
        <value>
            <label>make skewer sticks from a plank</label>
        </value>
    </li>
    </operations>
</match>
</Operation>

<Operation Class="PatchOperationRemove">
  <xpath>Defs/RecipeDef[defName="moas_CookStick"]</xpath>
</Operation>

<Operation Class="PatchOperationRemove">
  <xpath>Defs/RecipeDef[defName="moas_CookStick4"]</xpath>
</Operation>

</Patch>