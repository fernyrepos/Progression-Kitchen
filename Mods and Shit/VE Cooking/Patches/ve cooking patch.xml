<!-- better descriptions -->


<!-- OLD: A mixture of cocoa, water and sugar, forming a bitter-sweet pourable syrup, perfect for coating desserts. While still not good for you, chocolate syrup is not quite as bad as straight sugar.-->
  <Operation Class="PatchOperationReplace">
      <success>Always</success>
      <xpath>Defs/ThingDef[defName="VCE_ChocolateSyrup"]/description</xpath>
      <value>
      <description>A mixture of cocoa, water and sugar, forming a bitter-sweet pourable syrup, perfect for coating desserts. Applying the syrup to a gourmet meal will grant it a mood-boosting effect.</description>
      </value>
  </Operation>

<!-- OLD: A thick emulsion of egg, oil, and other herbs. Mayonnaise, while terrible for you, adds a pleasing tang and is very calorically dense. -->

  <Operation Class="PatchOperationReplace">
      <success>Always</success>
      <xpath>Defs/ThingDef[defName="VCE_Mayo"]/description</xpath>
      <value>
      <description>A thick emulsion of egg, oil, and other herbs. Applying the mayo to a gourmet meal will grant it a mood-boosting effect while also making the consumer less hungry for twelve hours.</description>
      </value>
  </Operation>

<!-- OLD: Insect jelly cut with sweetener then sealed as a preserve. Very rich and sweet, while being surprisingly healthy. -->

  <Operation Class="PatchOperationReplace">
      <success>Always</success>
      <xpath>Defs/ThingDef[defName="VCE_InsectJellyPreserves"]/description</xpath>
      <value>
      <description>Insect jelly processed into a sweetener. Applying the sweetener to a gourmet meal will grant it a mood-boosting effect.</description>
      </value>
  </Operation>

<!-- OLD: A thin and semi-sweet nectar, known for its healing and anti-inflammatory properties. Although healthier than sugar, its high fructose content may be harmful if taken constantly. -->

  <Operation Class="PatchOperationReplace">
      <success>Always</success>
      <xpath>Defs/ThingDef[defName="VCE_AgaveNectar"]/description</xpath>
      <value>
      <description>A thin and semi-sweet nectar, known for its healing and anti-inflammatory properties. Applying the nectar to a gourmet meal will grant it an immunity-boosting effect.</description>
      </value>
  </Operation>












